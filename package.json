{
  "name": "patterns-bank",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-agnostic design-pattern decision layer (MCP server): recommends patterns and flags over-engineering, grounded in curated decision cases.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "patterns-bank": "dist/adapters/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/cases/seed.ts",
    "mcp": "tsx src/adapters/mcp/server.ts",
    "demo": "tsx demo/scenarios.ts",
    "cli": "tsx src/adapters/cli/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
